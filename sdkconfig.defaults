# Defaults for Seeed Studio XIAO ESP32-C3 and BNO055 over I2C.
CONFIG_BNO055_I2C_SDA_GPIO=6
CONFIG_BNO055_I2C_SCL_GPIO=7
CONFIG_BNO055_I2C_FREQUENCY_HZ=100000
CONFIG_BNO055_OUTPUT_INTERVAL_MS=500

# XIAO has 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Send logs through XIAO's native USB-C connection.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
