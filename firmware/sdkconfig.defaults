# Seeed Studio XIAO ESP32-C3, BNO055 over I2C.
CONFIG_BNO055_I2C_SDA_GPIO=6
CONFIG_BNO055_I2C_SCL_GPIO=7
CONFIG_BNO055_I2C_FREQUENCY_HZ=100000
CONFIG_BNO055_OUTPUT_INTERVAL_MS=10
CONFIG_BNO055_TIMING_REPORT_INTERVAL_MS=5000
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_LOG_COLORS=n
