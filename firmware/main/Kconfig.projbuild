menu "BNO055 settings"

    config BNO055_I2C_SDA_GPIO
        int "I2C SDA GPIO (XIAO D4 = GPIO6)"
        range 0 21
        default 6

    config BNO055_I2C_SCL_GPIO
        int "I2C SCL GPIO (XIAO D5 = GPIO7)"
        range 0 21
        default 7

    config BNO055_I2C_FREQUENCY_HZ
        int "I2C frequency (Hz)"
        range 10000 400000
        default 100000
        help
            Start at 100 kHz. Faster I2C does not increase the NDOF output rate.

    config BNO055_OUTPUT_INTERVAL_MS
        int "Polling interval (ms)"
        range 10 60000
        default 10
        help
            NDOF fusion output updates nominally at 100 Hz (10 ms).

    config BNO055_TIMING_REPORT_INTERVAL_MS
        int "Timing report interval (ms, 0 disables)"
        range 0 60000
        default 5000
        help
            Reports polling rate, read/log duration and schedule overruns.

endmenu
