If:
  PathMatch: firmware/.*
CompileFlags:
  CompilationDatabase: firmware/build
  # GCC-only options from ESP-IDF; this affects editor analysis, not the build.
  Remove:
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -Wunused-but-set-variable=*
---
If:
  PathMatch: desktop/.*
CompileFlags:
  CompilationDatabase: desktop/build
